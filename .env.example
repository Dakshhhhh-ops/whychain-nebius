# Copy to .env and fill in. Never commit .env.
# The only thing WhyChain needs is a Nebius Token Factory key. Everything else here is optional.

# ---------- Models: NVIDIA Nemotron on Nebius Token Factory (OpenAI-compatible) ----------
# Key from https://tokenfactory.nebius.com (API keys). Without it the app still replays recorded investigations.
NEBIUS_API_KEY=your-nebius-token-factory-key
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
# Nemotron 3 Super for every agent role: reasoning off for fast data and document work ...
TF_MODEL=nvidia/nemotron-3-super-120b-a12b
TF_THINKING=false
# ... reasoning on (chat_template_kwargs.enable_thinking) for planning, judging and writing ...
TF_REASON_MODEL=nvidia/nemotron-3-super-120b-a12b
TF_REASON_THINKING=true
# ... and a different Nemotron model on Token Factory when the main one is overloaded or failing
TF_BACKUP_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
# Memory recall embeddings on Token Factory (it serves no Nemotron embedder). "off" = keyword recall.
WHYCHAIN_EMBED_MODEL=Qwen/Qwen3-Embedding-8B

# ---------- Data ----------
# "local": DuckDB queries every source in place (CSV, JSON, and Postgres when it is running). The default.
WHYCHAIN_HARNESS=local
# Optional: the Olist order system in Postgres (python -m datagen.olist loads it; docker compose up -d starts it).
# start.cmd / start.sh start the container only when this is true. Without it the order system is read from CSV.
USE_POSTGRES=false
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=erp
POSTGRES_USER=whychain
POSTGRES_PASSWORD=whychain-local

# ---------- Hosting a public demo (all off by default) ----------
# Live investigations spend Token Factory credits; recorded ones replay for free. On a public URL set these:
# WHYCHAIN_ACCESS_CODE=pick-a-code          # live investigations and approvals need it
# WHYCHAIN_MAX_PARALLEL_RUNS=2
# WHYCHAIN_MAX_RUNS_PER_DAY=20
# WHYCHAIN_DAILY_TOKEN_BUDGET=1000000       # about 40k tokens per investigation
# WHYCHAIN_RUN_TIMEOUT_S=900

# ---------- Behaviour ----------
WHYCHAIN_MAX_ROUNDS=2
# Fixes costing more than this (INR) need human approval
WHYCHAIN_APPROVAL_THRESHOLD_INR=300000

# ======================================================================================================
# Optional integrations. None is needed.
# ======================================================================================================
# NVIDIA NIM: used only when this key is set, and after Token Factory.
# NVIDIA_API_KEY=nvapi-your-key
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# NIM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# NIM_REASON_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# NIM_BACKUP_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Zetaris federated data platform instead of the local DuckDB harness (WHYCHAIN_HARNESS=zetaris)
# ZETARIS_URL=http://localhost:3000
# ZETARIS_DIR=C:\path\to\zetaris-platform
# ZETARIS_USER=your-zetaris-admin-email
# ZETARIS_PASSWORD=your-zetaris-admin-password
# ZETARIS_DATA_ROOT=/home/zetaris/customer-data/shared/whychain
# ZETARIS_PG_HOST=host.docker.internal
# ZETARIS_REST_URL=
# ZETARIS_API_KEY=
# ZETARIS_ORG_ID=

# Meterless engines bridge (cd meterless_bridge && npm start): H-MEM memory, World Model and Scout Intent routing
# instead of WhyChain's own memory, graph and router. Its embeddings also use Token Factory when NEBIUS_API_KEY is set.
# METERLESS_BRIDGE_URL=http://localhost:8787
# METERLESS_EMBEDDER=nvidia

# Meterless Nightshift: "Private documents" reads the written record with a model on this machine instead of the cloud
# NIGHTSHIFT_BASE_URL=http://127.0.0.1:8088/v1
# NIGHTSHIFT_API_KEY=your-nightshift-proxy-token
# NIGHTSHIFT_MODEL=meterless/local
# WHYCHAIN_PRIVATE_DOCS=false

# xAI Grok and Ollama: last-resort fallbacks, only when configured
# XAI_API_KEY=xai-your-key
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen3:8b
